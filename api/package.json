{
  "name": "@cranberrylabs/hr-api",
  "version": "0.1.0",
  "private": true,
  "description": "cranberrylabs-hr API and worker process",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/services/db/migrate-cli.ts",
    "smoke:workday": "tsx src/scripts/smoke-workday.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "bullmq": "^5.21.0",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "js-yaml": "^4.1.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.4",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
